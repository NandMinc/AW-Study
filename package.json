{
  "name": "aw-study",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Spaced repetition for lecture content, with your data kept on your own device",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "serve": "node server/server.mjs --port 8091",
    "icons": "node tools/make-icons.mjs",
    "test": "node tools/run-tests.mjs",
    "test:unit": "vitest run",
    "test:browsers": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "5.3.0",
    "idb": "^8.0.4",
    "katex": "0.19.1",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
